# 배포 설정 템플릿. 이 파일을 복사해서 값을 채운다.
#
#   cp deploy/config.env.example deploy/config.env
#
# deploy/config.env 는 .gitignore 에 들어 있다. 커밋되지 않는다.
# 이 저장소가 공개되어 있으므로 서버 주소·도메인 같은 값이 히스토리에
# 남지 않게 하려는 것이다.
#
# 비밀 값(API 키, 토큰)은 여기가 아니라 deploy/secrets.env 에 넣는다.
# 값에 공백이 있으면 따옴표로 감싼다. 그 외에는 따옴표를 쓰지 않는다.

# ── 반드시 채워야 하는 값 ────────────────────────────────────────────

# 배포 대상 서버. ssh 로 접속할 때 쓰는 그대로 적는다.
# 예: deploy@203.0.113.10  또는  ubuntu@rag.example.com
SSH_HOST=deploy@example.com

# Docker Hub 이미지 이름. USERNAME 을 본인 계정으로 바꾼다.
# 예: docker.io/cardanoian/ip-rag
IMAGE=docker.io/USERNAME/ip-rag

# 서비스 도메인. 이 도메인의 A/AAAA 레코드가 서버를 가리켜야
# Let's Encrypt 인증서가 자동 발급된다.
DOMAIN=rag.example.com

# Let's Encrypt 만료 알림을 받을 주소.
ACME_EMAIL=you@example.com

# ── 선택 값 (기본값으로 두어도 동작한다) ─────────────────────────────

# 컨테이너·네트워크·볼륨 이름의 접두사.
APP_NAME=ip-rag

# SSH 포트.
SSH_PORT=22

# 서버 접속에 쓸 개인키 파일. 비워두면 ssh 기본 동작(~/.ssh/id_* 와
# ssh-agent, ~/.ssh/config)에 맡긴다. Permission denied (publickey) 가
# 나면 여기에 키 경로를 지정한다.
# 값에 따옴표를 쓰지 않으면 ~ 도 그대로 쓸 수 있다.
# 예: SSH_KEY=~/.ssh/id_ed25519
SSH_KEY=

# 이미지를 빌드할 대상 아키텍처. 개발 머신이 Apple Silicon(arm64)이고
# 서버가 x86_64 면 이 값이 linux/amd64 여야 한다.
PLATFORM=linux/amd64

# 서버에서 배포 관련 파일을 두는 디렉터리.
# 시크릿(env), Caddyfile, 배포 이력(releases)이 여기 들어간다.
REMOTE_DIR=/opt/ip-rag

# 영속 데이터 볼륨 이름. 벡터·문서·운영 DB가 전부 여기 담긴다.
# 백업 단위도 이 볼륨 하나다.
DATA_VOLUME=ip-rag-data

# 앱 컨테이너와 프록시 컨테이너를 잇는 Docker 네트워크 이름.
NETWORK=ip-rag

# 관리자 화면(/admin) 접근을 허용할 IP·CIDR 목록. 공백으로 구분한다.
# 여기 없는 주소에서 /admin 을 열면 404 를 돌려준다.
# 비워두면 접근 제한 없이 인터넷에 그대로 노출되므로 권장하지 않는다.
# 예: ADMIN_ALLOW_IPS="203.0.113.7 10.0.0.0/8"
ADMIN_ALLOW_IPS=""

# 앱 컨테이너 포트를 서버의 이 주소에만 노출한다. 프록시는 도커 네트워크로
# 붙으므로 이 바인딩은 서버에서 직접 curl 로 확인할 때만 쓰인다.
# 0.0.0.0 으로 바꾸면 Docker 가 iptables 에 규칙을 넣어 방화벽(ufw)을 우회해
# 인터넷에 그대로 뚫린다. 반드시 루프백으로 둔다.
HOST_BIND=127.0.0.1
APP_PORT=8000

# 리버스 프록시 이미지.
PROXY_IMAGE=caddy:2-alpine

# 배포로 앱이 잠시 내려가 있는 동안 프록시가 요청을 붙들고 재시도할 시간.
# 이 값이 실제 교체 시간보다 길어야 사용자가 502 를 보지 않는다.
# Rails 쪽 호출 타임아웃도 이 값보다 길게 잡아야 의미가 있다.
LB_TRY_DURATION=60s

# 배포 후 /health 가 200 을 돌려줄 때까지 기다리는 최대 시간(초).
# 넘기면 이전 버전으로 자동 롤백한다. chromadb 임포트가 느려서 넉넉히 잡는다.
HEALTHCHECK_TIMEOUT=120

# 구 컨테이너에 SIGTERM 을 보낸 뒤 강제 종료까지 기다리는 시간(초).
# 색인 잡이 돌고 있을 수 있으므로 너무 짧게 잡지 않는다.
STOP_TIMEOUT=30

# 서버에 남겨둘 구버전 이미지 개수. 롤백 여지를 이만큼 확보한다.
KEEP_RELEASES=3
