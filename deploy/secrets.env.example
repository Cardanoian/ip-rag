# 이 파일을 deploy/secrets.env 로 복사한 뒤 값을 채운다.
#
#   cp deploy/secrets.env.example deploy/secrets.env
#
# deploy/secrets.env 는 .gitignore 에 들어 있다. 커밋되지 않는다.
# bin/deploy setup / bin/deploy secrets push 가 이 파일을 서버의
# /opt/ip-rag/env 로 보내고, 컨테이너는 --env-file 로 읽는다.
#
# 주의: docker 의 --env-file 은 따옴표를 값의 일부로 취급한다.
#       KEY="값" 이라고 쓰면 따옴표까지 값에 포함된다. 따옴표 없이 KEY=값 으로 쓴다.
#       한 줄에 하나씩, = 앞뒤에 공백을 두지 않는다.

# ── 반드시 채워야 하는 값 3개 ────────────────────────────────────────

# Gemini 임베딩 API 키. https://aistudio.google.com/apikey
# 없으면 /ready 가 503 을 반환하고 검색과 색인이 모두 실패한다.
GEMINI_API_KEY=

# Rails(Co-AI) 서버가 검색 API를 호출할 때 쓰는 Bearer 토큰.
# Rails credentials 의 rag.api_token 과 같은 값이어야 한다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_API_TOKEN=

# 관리자 세션 쿠키 서명 키.
# production 에서 이 값이 비어 있으면 재시작할 때마다 임의 키가 생성되어
# 관리자 로그인이 전부 풀리고 /ready 가 503 을 반환한다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ── 프록시 뒤에서 돌기 위한 값 ───────────────────────────────────────

# uvicorn 의 --proxy-headers 는 기본적으로 127.0.0.1 에서 온 요청의
# X-Forwarded-* 만 신뢰한다. Caddy 는 도커 네트워크 너머에 있으므로
# 이 값이 없으면 프록시 헤더가 전부 무시된다.
# 앱 포트는 서버 루프백에만 바인딩되므로 * 로 두어도 외부에서 위조할 수 없다.
FORWARDED_ALLOW_IPS=*

# ── 선택 값 ─────────────────────────────────────────────────────────
# 주석을 풀어 쓰면 컨테이너 기본값을 덮어쓴다.
# APP_ENV 와 DATA_DIR 은 Dockerfile 에 이미 production / /data 로 박혀 있으므로
# 여기서 건드리지 않는다.

# 동시에 처리할 검색 요청 수. 부하 시험 결과에 맞춰 조정한다.
# SEARCH_CONCURRENCY=10

# 검색 대기열에서 이 시간을 넘기면 503 을 반환한다.
# SEARCH_QUEUE_TIMEOUT_SECONDS=2.0

# Gemini 응답 제한(밀리초).
# GEMINI_TIMEOUT_MS=30000

# 관리자 세션 유효기간(초). 기본 8시간.
# ADMIN_SESSION_MAX_AGE=28800

# 한 번에 올릴 수 있는 파일 총 용량(바이트). 기본 20MB.
# 이 값을 올릴 때는 deploy/Caddyfile 의 max_size 도 함께 올려야 한다.
# 프록시가 먼저 끊으면 클라이언트는 이유를 모르는 413 만 받는다.
# 250MB = 262144000
# MAX_UPLOAD_BYTES=20971520

# zip 압축을 풀었을 때 허용하는 총 용량(바이트). 기본 200MB.
# 업로드 한도만 올리고 이 값을 두면 큰 zip 이 해제 단계에서 거부된다.
# 1GB = 1073741824
# MAX_UNZIPPED_BYTES=209715200

# 재색인 후 남겨둘 구버전 컬렉션 수.
# KEEP_OLD_COLLECTIONS=1

# 로그 레벨.
# LOG_LEVEL=INFO
