# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 Git에 올라가지 않습니다.
#
#   cp .env.example .env
#
# ============================================================================
# 1. 반드시 채워야 하는 값 3개
# ============================================================================

# ---------------------------------------------------------------------------
# GEMINI_API_KEY — 문장을 벡터로 바꾸는 Google Gemini API 키
# ---------------------------------------------------------------------------
# 어디서 받나: https://aistudio.google.com/apikey
# 없으면: 색인과 검색이 모두 503 오류를 냅니다.
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# RAG_API_TOKEN — Rails 서버가 이 검색 서버를 호출할 때 쓰는 공유 암호
# ---------------------------------------------------------------------------
# 두 서버가 같은 값을 갖고 있어야 합니다. Rails 쪽에는 credentials 의
# rag.api_token 에 같은 값을 넣습니다.
#
# 만드는 법 (터미널에서 실행):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# 없으면: APP_ENV=production 일 때 모든 검색 요청이 503 으로 막힙니다.
RAG_API_TOKEN=replace-with-a-long-random-token

# ---------------------------------------------------------------------------
# SESSION_SECRET — 관리자 로그인 세션을 서명하는 열쇠
# ---------------------------------------------------------------------------
# 무엇에 쓰이나:
#   관리자가 /admin 에 로그인하면 브라우저에 "로그인 쿠키"가 저장됩니다.
#   이 쿠키가 위조된 것이 아님을 증명하기 위해 서버가 이 값으로 서명합니다.
#   비밀번호처럼 남에게 알려지면 안 되는 값입니다.
#
# 왜 중요한가:
#   이 값이 유출되면 누구나 "나는 최고관리자다"라고 적힌 쿠키를 스스로 만들어
#   로그인 없이 관리자 화면에 들어올 수 있습니다. 비밀번호를 아무리 강하게
#   해도 소용이 없어집니다.
#
# 어떤 값을 넣나:
#   사람이 지어낸 단어가 아니라 컴퓨터가 만든 길고 무작위한 문자열이어야
#   합니다. 아래 명령을 터미널에 그대로 붙여넣고 나온 값을 넣으세요.
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
#   출력 예 (이 값을 그대로 쓰지 마세요. 직접 만드세요):
#     kJ8x2mQvR7nT4wY9pL3sB6hN1cF5dG0aZeX-uI7oM2rV8tK4yW6qS9jH3lP5nD1b
#
# 주의사항:
#   - 값을 바꾸면 로그인 중인 관리자가 전부 로그아웃됩니다.
#   - 서버를 여러 대로 늘리면 모든 서버가 같은 값을 써야 합니다.
#   - 개발용과 운영용은 서로 다른 값을 쓰세요.
#   - 이 값을 Git, 메신저, 문서에 붙여넣지 마세요.
#
# 없으면 어떻게 되나:
#   개발 환경(APP_ENV=development)에서는 고정된 임시 키로 동작합니다.
#   운영 환경(APP_ENV=production)에서는 서버가 켜질 때마다 새 임시 키를
#   만들어 쓰므로, 서버를 재시작할 때마다 관리자 로그인이 전부 풀리고
#   /ready 가 503 을 반환합니다.
SESSION_SECRET=replace-with-a-long-random-secret

# ============================================================================
# 2. 환경 구분
# ============================================================================

# development — 로컬 개발용. 서비스 토큰 없이도 검색 API를 호출할 수 있습니다.
# production  — 실제 배포용. 토큰 검사, HTTPS 전용 쿠키가 켜집니다.
APP_ENV=development

# ============================================================================
# 3. 데이터 저장 위치
# ============================================================================

# 벡터(chroma_db), 원본 문서(docs), 운영 DB(app.db)가 모두 이 폴더 아래
# 만들어집니다. 백업할 대상은 이 폴더 하나입니다.
#
#   data/
#   ├── chroma_db/        검색용 벡터
#   ├── docs/{corpus}/    관리자가 올린 원본 문서
#   └── app.db            corpus 설정, 관리자 계정, 색인 작업 기록, 감사 로그
#
# Docker 로 띄울 때는 /data 볼륨을 마운트하고 이 값을 /data 로 둡니다.
DATA_DIR=./data

# 아래 세 개는 DATA_DIR 기준으로 자동 결정되므로 보통 건드릴 필요가 없습니다.
# DOCS_ROOT=./data/docs
# APP_DB_PATH=./data/app.db
# CHROMA_PATH=./data/chroma_db

# 예전 배포와의 호환용. 발명 corpus 문서를 옛 경로(repo 의 docs/)에 그대로
# 두고 싶을 때만 사용합니다. 보통은 scripts.migrate_docs 로 옮기고 비워둡니다.
# INVENTIONS_DOCS_DIR=./docs

# ============================================================================
# 4. 시드 corpus 초기값 (거의 건드릴 일 없음)
# ============================================================================

# corpus 설정은 이제 데이터베이스(app.db 의 corpora 표)가 관리합니다.
# 아래 두 값은 데이터베이스가 비어 있을 때 기본 발명 corpus 를 처음 만들면서
# 한 번만 사용됩니다. 그 뒤의 변경은 /admin 화면에서 합니다.
INDEX_VERSION=inventions-gemini-embedding-2-1536-v1
CORPUS_ID=national-student-invention-awards-1979-2017

# ============================================================================
# 5. 성능·한도 조정값 (선택)
# ============================================================================

# 동시에 처리할 검색 요청 수. 늘리면 Gemini API 호출도 함께 늘어납니다.
# SEARCH_CONCURRENCY=10

# 위 한도가 꽉 찼을 때 대기하는 시간(초). 넘으면 503 을 반환합니다.
# SEARCH_QUEUE_TIMEOUT_SECONDS=2.0

# Gemini API 응답 대기 제한(밀리초).
# GEMINI_TIMEOUT_MS=30000

# 관리자 로그인 유지 시간(초). 기본 8시간.
# ADMIN_SESSION_MAX_AGE=28800

# 한 번에 올릴 수 있는 파일 총 용량(바이트). 기본 20MB.
# MAX_UPLOAD_BYTES=20971520

# zip 압축을 풀었을 때 허용하는 총 용량(바이트). 기본 200MB.
# MAX_UNZIPPED_BYTES=209715200

# 전체 재색인 후 되돌리기용으로 남겨둘 예전 벡터 묶음 개수. 기본 1개.
# KEEP_OLD_COLLECTIONS=1
